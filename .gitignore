# ==========================================================================
# This agent
# ==========================================================================

/target

# Secrets never belong in the source: seal them from the agent's page.
.env
.env.*
!.env.example

# ==========================================================================
# AI tools
# ==========================================================================

# Local settings and notes from coding assistants
.claude/settings.local.json
CLAUDE.local.md
.aider*

# Model weights in formats the executor doesn't run (it runs ONNX files,
# which an agent ships in its project, so those are not ignored here)
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth

