GitHub.sublime-settings

# ---- Visual Studio Code (github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore) ----

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace

# Built Visual Studio Code Extensions
*.vsix

# ---- Zed (github.com/github/gitignore/blob/main/Global/Zed.gitignore) ----

# Zed
# https://zed.dev/docs/configuring-zed#settings-files
#
# Zed stores project settings in a .zed/ directory, similar to .vscode/.
# By default, ignore the directory but allow commonly shared config files.

.zed/*
!.zed/settings.json
!.zed/tasks.json
!.zed/debug.json

# ---- Xcode (github.com/github/gitignore/blob/main/Global/Xcode.gitignore) ----

## User settings
xcuserdata/

# ---- Cursor (github.com/github/gitignore/blob/main/Global/Cursor.gitignore) ----

.cursorignore
.cursorindexingignore

# ==========================================================================
# Never ignored
# ==========================================================================

# Some patterns above are broad (`debug`, `logs`, `*.mod*`, `*.map`), and anything
# ignored is left out of the zip you publish. So the agent's own folders,
# its data and its ONNX models always count.
!/src/**/
!/tests/**/
!/data/**
!*.onnx

# Except these, wherever they are: secrets never belong in the source, and
# the OS leaves its own files everywhere
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
